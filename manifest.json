{
  "manifest_version": 3,
  "name": "Scam Spotter",
  "version": "1.0.0",
  "description": "Paste a suspicious message or link and get a plain-English answer. Everything stays on your computer.",

  "permissions": ["contextMenus"],

  "action": {
    "default_title": "Is this a scam?",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
