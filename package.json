{
  "name": "pr-radar",
  "version": "1.0.0",
  "private": true,
  "description": "A personal dashboard for the pull requests that are actually waiting on you.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace web",
    "start": "npm run build && node --env-file-if-exists=.env server/src/index.js",
    "server": "node --env-file-if-exists=.env server/src/index.js",
    "sync": "node --env-file-if-exists=.env server/src/cli-sync.js",
    "test": "node --test server/test/*.test.js",
    "demo": "npm run build && DEMO_MODE=1 node server/src/index.js"
  }
}
