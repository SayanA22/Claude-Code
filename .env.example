# ---------------------------------------------------------------------------
# DayOS environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Supabase — both of these are safe to expose to the browser. They only work in
# combination with Row Level Security, which DayOS enables on every table.
#
# The key goes in ANON_KEY whichever format your project issues: newer projects
# give you a publishable key (sb_publishable_...), older ones a legacy anon JWT
# (eyJ...). The client treats them the same. Do NOT use a service-role or
# sb_secret_ key — DayOS needs neither, because every write goes through the
# signed-in user's own session, keeping Row Level Security in the enforcement
# path.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Anthropic API key. SERVER ONLY — all model calls happen in route handlers.
# If this is unset, DayOS falls back to a deterministic local planner/parser so
# the app stays fully usable in development.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model override (defaults to claude-opus-5).
DAYOS_AI_MODEL=claude-opus-5

# Set to "true" to expose the demo-data seeding button in the profile screen.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
