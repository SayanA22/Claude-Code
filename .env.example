# Copy to .env and fill in. Never commit .env.
#
# A GitHub personal access token. This is the only required setting.
#   Classic token:      needs the `repo` scope (and `read:org` for org repos)
#   Fine-grained token: needs Pull requests: Read, Contents: Read, Metadata: Read
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_replace_me

# Port for the dashboard. Default 4000.
PORT=4000

# How often to refresh from GitHub, in minutes. Default 5.
# GitHub allows 5000 GraphQL points/hour; one sync costs ~2, so this is very safe.
SYNC_INTERVAL_MINUTES=5

# A PR with no activity for this many days is flagged as stale. Default 7.
STALE_AFTER_DAYS=7

# Optional. Limit the dashboard to specific repos, comma-separated.
# Leave blank to include every repo you can see.
# REPO_FILTER=myorg/api,myorg/web

# Where the SQLite file lives. Default ./data/radar.db
# DB_PATH=./data/radar.db
